{
"$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
"name": "throbbing-mode-5ef2",
"main": "worker.js",
"compatibility_date": "2026-08-05",
"keep_vars": true,
"assets": {
"directory": "./",
"binding": "ASSETS",
"html_handling": "none",
"run_worker_first": ["/404.html", "/about.html", "/deathstack.html", "/embed.html", "/embed/top10.html", "/game.html", "/index.html", "/news.html", "/privacy.html", "/realms.html", "/state-of-ai-tools.html", "/submit.html", "/submitted.html", "/terms.html", "/thanks.html", "/vault.html"]
},
"kv_namespaces": [
{
"binding": "SUBSCRIBERS",
"id": "d3a0828b34be497aa2a264631373be7b"
},
{
"binding": "SUBMISSIONS",
"id": "55764449171e450e93d688b4485fc7a9"
},
{
"binding": "NEWS",
"id": "36562e96bcdb41849da8d7a33f1d8407"
},
{
"binding": "REALMS",
"id": "3e81a86717124477b2695139999b4799"
}
],
"triggers": {
"crons": ["0 */6 * * *"]
},
"ai": {
"binding": "AI"
},
"r2_buckets": [
{
"binding": "VAULT_BUCKET",
"bucket_name": "solosgems-vault"
}
]
}
